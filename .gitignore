# Data: raw pulls, intermediate tables, processed outputs and corpora are large, re-buildable, or
# copyrighted publisher full text. Only the .gitkeep placeholders are tracked.
data/raw/*
data/interim/*
data/processed/*
data/corpora/*
data/projects/*
data/cache/
data/pkgs/
data/*.h5ad
!data/**/.gitkeep

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# uv
.uv/

# Local literature store (copyrighted publisher full text, never committed)
corpus/

# Unpublished drafts, photos, personal material
*.docx
*.HEIC
*.pdf

# Local
/handoff/
.data/
.claude/settings.local.json
tests/
gpu-ssh-handoff/

# Frontend build and local secrets
.env
.env.*
!.env.example
node_modules/
frontend/dist/
frontend/test-results/
frontend/playwright-report/
!tests/
tests/*
!tests/test_frontend_server.py
*.tsbuildinfo

# Local agent instructions and team coordination
/AGENTS.md
/CLAUDE.md
/COORDINATION.md

# Local planning, documentation, review captures, and presentation exports
/BOARD.md
/plans/
/tasks/
/docs/
